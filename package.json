{
  "name": "claude-code-branching",
  "version": "1.2.0",
  "description": "Branching for Claude Code conversations: branch tree, global catalogue, restart from any message",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "branching",
    "conversation",
    "transcript",
    "fork",
    "checkpoint"
  ],
  "type": "module",
  "bin": {
    "cb": "bin/cb.js"
  },
  "scripts": {
    "test": "node src/prove.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "src",
    "!src/*.test.js",
    "!src/prove.js",
    "!src/verifica-reale.js",
    "hooks",
    "README.md",
    "README.it.md",
    "LICENSE"
  ],
  "author": "Sasha Bolea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasha-bolea/claude-code-branching.git"
  },
  "homepage": "https://github.com/sasha-bolea/claude-code-branching#readme",
  "bugs": {
    "url": "https://github.com/sasha-bolea/claude-code-branching/issues"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
