{
  "name": "claude-code-branching",
  "version": "1.3.0",
  "description": "Branching for Claude Code conversations: branch tree, restart from any message with files restored, global session catalogue, prompt queue and folder notes",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "branching",
    "conversation",
    "transcript",
    "fork",
    "checkpoint",
    "rewind",
    "undo",
    "session",
    "prompt-queue",
    "notes",
    "tui",
    "terminal",
    "pty",
    "agentic-coding",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "cb": "bin/cb.js"
  },
  "scripts": {
    "test": "node src/prove.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "files": [
    "bin",
    "src",
    "!src/*.test.js",
    "!src/prove.js",
    "!src/verifica-reale.js",
    "hooks",
    "README.md",
    "README.it.md",
    "LICENSE"
  ],
  "author": "Sasha Bolea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasha-bolea/claude-code-branching.git"
  },
  "homepage": "https://github.com/sasha-bolea/claude-code-branching#readme",
  "bugs": {
    "url": "https://github.com/sasha-bolea/claude-code-branching/issues"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
